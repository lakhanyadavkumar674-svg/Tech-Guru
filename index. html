    margin-bottom:10px;
}

.feature p{
    color:#8ba9c3;
    margin-top:5px;
}

/* =========================
   DOWNLOAD MODAL
========================= */

.modal{
    display:none;
    position:fixed;
    inset:0;
    background:#000000bb;
    backdrop-filter:blur(10px);
    z-index:200;
    align-items:center;
    justify-content:center;
}

.modal-box{
    width:90%;
    max-width:450px;
    background:
        linear-gradient(145deg,#092440,#020b17);
    border:1px solid #008cff;
    border-radius:25px;
    padding:30px;
    text-align:center;
    box-shadow:
        0 0 40px #008cff77,
        inset 0 0 30px #008cff22;
    animation:popup .3s ease;
}

@keyframes popup{
    from{
        transform:scale(.7);
        opacity:0;
    }
    to{
        transform:scale(1);
        opacity:1;
    }
}

.modal-box h2{
    color:#00aaff;
    margin-bottom:10px;
}

.modal-box p{
    color:#bdd8ed;
    margin-bottom:20px;
}

.progress{
    height:10px;
    background:#0b2035;
    border-radius:20px;
    overflow:hidden;
    margin:20px 0;
}

.progress-bar{
    width:0%;
    height:100%;
    background:#00aaff;
    box-shadow:0 0 15px #00aaff;
    transition:width .2s;
}

.real-download{
    display:none;
    background:#00aaff;
    color:white;
    text-decoration:none;
    padding:13px 25px;
    border-radius:30px;
    font-weight:bold;
}

.close{
    margin-top:18px;
