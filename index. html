<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#020712;
    color:white;
    overflow-x:hidden;
}

/* =========================
   ANIMATED 3D BACKGROUND
========================= */

.background{
    position:fixed;
    inset:0;
    overflow:hidden;
    z-index:-5;
    background:
        radial-gradient(circle at 20% 20%,#07386b55,transparent 30%),
        radial-gradient(circle at 80% 70%,#004cff44,transparent 30%),
        #020712;
}

.orb{
    position:absolute;
    border-radius:50%;
    filter:blur(2px);
    opacity:.45;
    animation:float 8s infinite ease-in-out;
}

.orb1{
    width:250px;
    height:250px;
    background:#008cff;
    top:10%;
    left:5%;
    box-shadow:0 0 100px #008cff;
}

.orb2{
    width:180px;
    height:180px;
    background:#0066ff;
    right:10%;
    top:20%;
    animation-delay:2s;
    box-shadow:0 0 100px #0066ff;
}

.orb3{
    width:300px;
    height:300px;
    background:#00b7ff;
    bottom:-100px;
    left:40%;
    animation-delay:4s;
    box-shadow:0 0 120px #00b7ff;
}

@keyframes float{
    0%,100%{
        transform:translate3d(0,0,0) scale(1);
    }
    50%{
        transform:translate3d(80px,-60px,100px) scale(1.15);
    }
}

/* 3D GRID */

.grid{
    position:absolute;
    width:200%;
    height:70%;
    left:-50%;
    bottom:-25%;
    background:
        linear-gradient(#008cff33 1px,transparent 1px),
        linear-gradient(90deg,#008cff33 1px,transparent 1px);
    background-size:50px 50px;
    transform:perspective(500px) rotateX(65deg);
    animation:gridMove 5s linear infinite;
}

@keyframes gridMove{
    from{
        background-position:0 0;
    }
    to{
        background-position:0 50px;
    }
}

/* =========================
   HEADER
========================= */

header{
    height:75px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 5%;
    background:#020916dd;
    border-bottom:1px solid #0c4775;
    backdrop-filter:blur(15px);
    position:sticky;
    top:0;
    z-index:50;
}

.logo{
    display:flex;
    align-items:center;
    gap:10px;
    font-size:25px;
    font-weight:bold;
}

.logo-icon{
    width:45px;
    height:45px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:25px;
    background:linear-gradient(135deg,#00b7ff,#0055ff);
    box-shadow:0 0 25px #008cff;
}

.logo span{
    color:#00aaff;
}

nav{
    display:flex;
    gap:25px;
}

nav a{
    color:white;
    text-decoration:none;
    transition:.3s;
}

nav a:hover{
    color:#00aaff;
    text-shadow:0 0 15px #00aaff;
}

.login{
    padding:11px 23px;
    background:linear-gradient(90deg,#009cff,#005cff);
    border-radius:30px;
    color:white;
    text-decoration:none;
    font-weight:bold;
}

/* =========================
   HERO
========================= */

.hero{
    min-height:530px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:70px 7%;
    position:relative;
}

.hero-text{
    width:52%;
}

.small-title{
    color:#00aaff;
    font-size:20px;
    letter-spacing:2px;
    margin-bottom:15px;
}

.hero h1{
    font-size:75px;
    line-height:.95;
}

.hero h1 span{
    color:#00aaff;
    text-shadow:
        0 0 10px #00aaff,
        0 0 40px #006cff;
}

.hero p{
    color:#c9e5ff;
    font-size:20px;
    margin:25px 0;
}

.play-btn{
    display:inline-block;
    padding:16px 35px;
    background:linear-gradient(90deg,#009cff,#0055ff);
    color:white;
    text-decoration:none;
    border-radius:35px;
    font-size:19px;
    font-weight:bold;
    box-shadow:0 0 30px #008cff88;
    transition:.3s;
}

.play-btn:hover{
    transform:scale(1.08);
    box-shadow:0 0 50px #008cff;
}

/* 3D CHARACTER */

.gamer{
    width:43%;
    height:400px;
    display:flex;
    justify-content:center;
    align-items:center;
    position:relative;
}

.gamer-ring{
    width:320px;
    height:320px;
    border:2px solid #008cff55;
    border-radius:50%;
    box-shadow:
        0 0 30px #008cff,
        inset 0 0 50px #008cff55;
    animation:rotate 8s linear infinite;
}

.gamer-icon{
    position:absolute;
    font-size:180px;
    filter:drop-shadow(0 0 30px #008cff);
    animation:characterFloat 3s ease-in-out infinite;
}

@keyframes rotate{
    to{
        transform:rotate(360deg);
    }
}

@keyframes characterFloat{
    0%,100%{
        transform:translateY(0);
    }
    50%{
        transform:translateY(-20px);
    }
}

/* =========================
   GAMES
========================= */

.games-section{
    padding:50px 5%;
}

.title{
    font-size:35px;
    margin-bottom:30px;
}

.title span{
    color:#00aaff;
}

.games{
