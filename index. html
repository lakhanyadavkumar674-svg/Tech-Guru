<script>

/* =========================
   DOWNLOAD SYSTEM
========================= */

function openDownload(game){

    const modal =
        document.getElementById("downloadModal");

    const name =
        document.getElementById("gameName");

    const text =
        document.getElementById("downloadText");

    const bar =
        document.getElementById("progressBar");

    const download =
        document.getElementById("realDownload");


    modal.style.display="flex";

    name.innerText =
        "Download " + game;

    text.innerText =
        "Preparing " + game + "...";

    bar.style.width="0%";

    download.style.display="none";


    let progress=0;


    const timer=setInterval(function(){

        progress += 10;

        bar.style.width =
            progress + "%";

        text.innerText =
            "Preparing download... "
            + progress + "%";


        if(progress>=100){

            clearInterval(timer);

            text.innerText =
                game + " is ready to download!";

            download.style.display =
                "inline-block";

            /*
              IMPORTANT:
              यहाँ अपनी असली गेम फाइल का URL लगाएँ।

              Example:
              download.href =
              "games/my-game.apk";

              या:

              download.href =
              "downloads/game.zip";
            */

            download.href =
                "downloads/" +
                game.toLowerCase()
                .replaceAll(" ","-") +
                ".zip";

        }

    },200);

}


function closeDownload(){

    document.getElementById(
        "downloadModal"
    ).style.display="none";

}

</script>

